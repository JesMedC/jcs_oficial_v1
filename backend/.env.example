# Default market data provider: dukascopy | oanda
SCANNER_PROVIDER=dukascopy

# Active forex pair in Dukascopy slash notation. Examples:
#   EUR/USD, GBP/USD, USD/JPY, AUD/USD, USD/CAD
SCANNER_SYMBOL=EUR/USD

# Historical lookback for the rolling buffer
SCANNER_HISTORY_DAYS=3

# Number of 5-minute candles to keep in the rolling buffer
SCANNER_BUFFER_SIZE=500

# WebSocket broadcast interval (ms)
SCANNER_TICK_INTERVAL_MS=1000

# OANDA (only used if SCANNER_PROVIDER=oanda)
# Leave OANDA_API_TOKEN empty to fall back to yfinance automatically.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
