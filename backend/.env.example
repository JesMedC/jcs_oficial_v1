# JadeCapitalSuite — backend .env template
#
# Copy to ``.env`` (or ``../.env`` at the repo root, depending on where
# docker-compose reads it) and fill in the values that aren't safe to
# commit. All keys are case-insensitive — ``pydantic-settings`` reads
# them either way.
#
# The runtime container also accepts these via the shell environment;
# ``docker-compose.yml`` injects them with sensible defaults so leaving
# any of them blank here is fine for a fresh local stack (Google OAuth
# endpoints will return 503, MercadoPago endpoints will be inactive).

# --- Database -------------------------------------------------------------
# Async driver (FastAPI runtime).
DATABASE_URL=postgresql+asyncpg://jcs:jcs@postgres:5432/jcs
# Sync driver (Alembic migrations — must match DATABASE_URL but with psycopg2).
DATABASE_URL_SYNC=postgresql+psycopg2://jcs:jcs@postgres:5432/jcs

# --- JWT ------------------------------------------------------------------
# Must be at least 32 chars. The docker-compose default is a dev placeholder;
# rotate before any non-local deploy.
JWT_SECRET=change-me-in-production-min-32-chars-aaaa
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# --- CORS -----------------------------------------------------------------
# Comma-separated origins. Dev defaults to localhost:5173 (Vite) plus the
# production apex so the SPA can talk to the API from either host.
CORS_ALLOW_ORIGINS=https://jadecapitalsuite.com,http://localhost:5173

# --- Environment ----------------------------------------------------------
# One of: development | staging | production. Controls the
# ``is_production`` property used by auth/cookie security checks.
ENVIRONMENT=development
LOG_LEVEL=INFO
# ``console`` for human-readable dev logs, ``json`` for structured logs
# in staging/production.
LOG_FORMAT=console

# --- MercadoPago ----------------------------------------------------------
# Leave empty in dev — the integration degrades gracefully and the
# upgrade endpoints return 503 with a clear envelope.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=
# Optional: HMAC secret to verify webhook signatures. Empty disables
# verification (DEV ONLY — do not expose to the internet).
MERCADOPAGO_WEBHOOK_SECRET=

# --- Frontend -------------------------------------------------------------
# Used by ``upgrade_subscription`` to build MercadoPago back_urls when the
# client doesn't pass them. In dev this is the Vite server.
FRONTEND_BASE_URL=http://localhost:5173

# --- Google OAuth (p0auth.1) ----------------------------------------------
# Set all three to enable Google login. When ANY is empty, the
# ``/api/v1/auth/google/login`` and ``/api/v1/auth/google/callback``
# endpoints return 503 with code=INTERNAL_ERROR and the message
# "Google login no esta configurado".
#
# Setup steps live in docs/google-oauth-setup.md (T8 of the login
# end-to-end feature). The redirect_uri MUST match the Authorized
# redirect URI configured in Google Cloud Console EXACTLY.
#
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Example for local dev through nginx: https://localhost/api/v1/auth/google/callback
# Example for prod:                  https://jadecapitalsuite.com/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
