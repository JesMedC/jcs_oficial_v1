# JadeCapitalSuite Backend — variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://jcs:jcs@localhost:5432/jcs
DATABASE_URL_SYNC=postgresql+psycopg2://jcs:jcs@localhost:5432/jcs

# --- JWT ---
# Minimo 32 caracteres. ROTAR en produccion.
JWT_SECRET=change-me-in-production-min-32-chars-aaaa
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# --- CORS ---
# Lista separada por comas. En produccion solo el dominio canonico.
CORS_ALLOW_ORIGINS=https://jadecapitalsuite.com,http://localhost:5173

# --- Entorno ---
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=console

# --- MercadoPago (p0c: integración real) ---
# Access token de producción (empieza con APP_USR-). Vacío en dev desactiva
# los pagos reales y devuelve MP_NOT_CONFIGURED en /subscriptions/upgrade.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=
# Secret para verificar la firma x-signature de los webhooks. Vacío en dev
# acepta TODOS los webhooks — no exponer el endpoint a internet en ese modo.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Frontend ---
# Usado por /subscriptions/upgrade para construir las back_urls por defecto
# (success / failure / pending apuntan a <base>/payment/{success,failure}).
FRONTEND_BASE_URL=http://localhost:5173